rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Document ID: {uid}
    // Fields: uid, email, fullName, role, (optional: program, yearLevel)
    
    // Collection: classrooms
    // Fields: name, instructorId, joinCode, studentIds (array)

    // Collection: materials
    // Fields: userId, title, content, uploadDate
    
    // Collection: quizzes
    // Fields: userId, materialId, quizName, generationDate, type ('ai' | 'instructor'), classroomId (optional), timeLimit (optional)
    
    // Collection: quizzes/{quizId}/questions
    // Fields: quizId, questionText, questionType, correctAnswer, options, explanation
    
    // Collection: attempts
    // Fields: userId, quizId, startTime, endTime, score, totalQuestions, classroomId (optional)
    
    // Collection: proficiency
    // Fields: userId, topicName, proficiencyLevel, lastUpdated

    // Collection: questionBank
    // Fields: questionText, questionType, correctAnswer, options, explanation, topic, difficulty (e.g. 'easy', 'medium', 'hard'), createdBy

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function hasRole(roleName) {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserRole() == roleName;
    }

    function isSystemAdmin() {
      return hasRole('system_admin');
    }

    function isInstructor() {
      return hasRole('instructor');
    }

    function isAcademicAdmin() {
      return hasRole('academic_admin');
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid); 
      allow delete: if isSystemAdmin();
    }

    match /classrooms/{classroomId} {
      allow read: if isAuthenticated();
      // Allow create if instructor, or relax temporarily for robust UI
      allow create: if isAuthenticated() && request.resource.data.instructorId == request.auth.uid;
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.instructorId == request.auth.uid;
    }

    match /materials/{materialId} {
      // Split list and get to prevent query evaluation errors
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isInstructor() || isAcademicAdmin());
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /quizzes/{quizId} {
      // Instructors and admins can read all quizzes
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAcademicAdmin());
      
      match /questions/{questionId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        // Relax write for subcollections
        allow write: if isAuthenticated();
      }
    }

    match /attempts/{attemptId} {
      allow list: if isAuthenticated() && (
        isSystemAdmin() ||
        isAcademicAdmin() ||
        isInstructor() || 
        resource.data.userId == request.auth.uid
      );
      allow get: if isAuthenticated() && (
        isSystemAdmin() ||
        isAcademicAdmin() ||
        isInstructor() || 
        resource.data.userId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /proficiency/{profId} {
      allow list: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow get: if isAuthenticated() && (resource.data.userId == request.auth.uid || isInstructor() || isAcademicAdmin());
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /audit_logs/{logId} {
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow read: if isSystemAdmin() || isAcademicAdmin();
    }

    match /ai_predictions/{predId} {
      allow create: if isAuthenticated() && request.resource.data.user_id == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.user_id == request.auth.uid || isInstructor() || isAcademicAdmin());
    }

    match /questionBank/{questionId} {
      // Used by instructors to build and categorize questions
      allow read: if isAuthenticated();
      // Relaxed to prevent strict role validation block during testing
      allow write: if isAuthenticated();
    }
  }
}